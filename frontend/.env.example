# Address of the backend API.
# Leave EMPTY in development: Vite forwards /api to http://localhost:4000 (see vite.config.ts).
# Leave it EMPTY in production too when the API server serves the website (the Render setup in
# render.yaml): website and API then share one address. Only set it if you host the website
# somewhere else, e.g. https://api.quickquote.example (the login cookie then needs extra setup).
VITE_API_URL=
