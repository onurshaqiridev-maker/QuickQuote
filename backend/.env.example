# Quick Quote backend - environment variables
# Copy this file to ".env" and adjust the values:   cp .env.example .env
# NEVER put real secrets in this file - it is committed to Git.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------
# Matches docker-compose.yml. Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://quickquote:quickquote@localhost:5432/quickquote
# Set to true when your database provider requires an encrypted connection
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Login sessions --------------------------------------------------------
# Replace with a long random string (at least 32 characters), e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Public addresses -------------------------------------------------------
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# --- Email ------------------------------------------------------------------
# "console" prints emails in the worker terminal (no account needed).
# "resend" really sends them through Resend (needs RESEND_API_KEY).
EMAIL_DRIVER=console
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Quick Quote <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL=admin@example.com
EMAIL_POLL_INTERVAL_MS=5000
EMAIL_BATCH_SIZE=10
# 5 attempts = 1 first try + 4 retries (minimum 4)
EMAIL_MAX_ATTEMPTS=5
EMAIL_SEND_TIMEOUT_MS=10000
EMAIL_LOCK_TIMEOUT_MINUTES=10

# --- Paid plans -----------------------------------------------------------------
# false = free launch: businesses can publish without paying (Starter limits apply).
# Set to true when payments are introduced.
SUBSCRIPTIONS_REQUIRED=false

# --- Uploaded images (logos and photos) ------------------------------------------
# Folder for uploaded files. On hosts without a permanent disk, files are lost on redeploy
# (cloud storage comes later, see docs/ARCHITECTURE.md section 3.5).
UPLOAD_DIR=./uploads

# --- Health check ------------------------------------------------------------
HEALTH_DB_TIMEOUT_MS=2000

# --- Seed script (npm run seed) ------------------------------------------------
# Creates the first administrator account if it does not exist yet.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
